# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/learnify

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Production Settings
NODE_ENV=production
PRODUCTION_CALLBACK_URL=https://your-app-url.onrender.com/auth/google/callback

# AWS S3 Configuration (Optional - for video uploads)
# If not configured, video upload feature will be disabled
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
CLOUDFRONT_DDN=your_cloudfront_distribution_domain_name
